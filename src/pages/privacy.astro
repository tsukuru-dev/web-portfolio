---
import Layout from '../layouts/Layout.astro';
import CommandBar from '../components/CommandBar.astro';
import '../styles/enquire.css';
---

<Layout title="Privacy notice — Madhatter Studio" description="How Madhatter Studio uses details submitted through the project enquiry form.">
  <CommandBar />
  <main class="legal-page shell" id="top">
    <p class="eyebrow"><span></span> Privacy notice</p>
    <h1>Your details stay<br /><em>your details.</em></h1>
    <div class="legal-copy">
      <section><h2>What is collected</h2><p>The project enquiry form collects the contact and project information you choose to provide.</p></section>
      <section><h2>How it is used</h2><p>Your information is used only to assess and respond to your enquiry, discuss the project and keep a record of the conversation where necessary.</p></section>
      <section><h2>How long it is kept</h2><p>Enquiry information is kept only as long as reasonably needed for project discussions, business records or legal obligations.</p></section>
      <section><h2>Your choices</h2><p>You can ask for your enquiry information to be corrected or deleted by replying to the response you receive.</p></section>
    </div>
    <a class="button" href="/enquire/">Back to the enquiry <span>↗</span></a>
  </main>
</Layout>

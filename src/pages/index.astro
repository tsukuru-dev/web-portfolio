---
import Layout from '../layouts/Layout.astro';
import CommandBar from '../components/CommandBar.astro';
import { projects } from '../data/projects';

const principles = [
  {
    number: '01',
    title: 'Design shapes perception.',
    text: "It isn't decoration. It tells people whether a business is thoughtful, credible and worth their time.",
  },
  {
    number: '02',
    title: 'First impressions sell.',
    text: "You're not buying pages. You're creating the moment someone decides to trust you, choose you or keep scrolling.",
  },
  {
    number: '03',
    title: 'Details make the difference.',
    text: 'The type, spacing, interactions and mobile experience all contribute to how considered the finished brand feels.',
  },
];

const caseStudies = {
  curry: {
    name: 'El Curry Loco',
    summary: 'A bold restaurant concept bringing Mexican street-food energy and Indian flavour together in one unmistakable digital identity.',
    brief: 'Create a lively, appetite-led website that explains the fusion immediately, feels independent rather than corporate, and gives a new restaurant a memorable first impression.',
    goals: ['Make the Mexican–Indian concept instantly understandable', 'Put signature food and personality at the centre', 'Make menus, location details and ordering actions easy to find', 'Translate the atmosphere cleanly across mobile and desktop'],
    fonts: 'Manrope for bold, direct headlines · Fraunces Italic for warmth and flavour',
    colours: [{ name: 'Saffron', value: '#E8B746' }, { name: 'Chilli', value: '#CB5B3E' }, { name: 'Cocoa', value: '#39241D' }, { name: 'Cream', value: '#FFF1DA' }],
  },
  fjd: {
    name: 'FJD Autos',
    summary: 'A cleaner, friendlier workshop identity designed to make a trusted family-run garage feel as dependable online as it does in person.',
    brief: 'Reframe an independent garage around clarity, trust and long-term care. The website needs to reassure drivers, explain services without jargon and make booking feel straightforward.',
    goals: ['Build trust before a customer picks up the phone', 'Present services in clear, everyday language', 'Make location, opening hours and booking details effortless to find', 'Balance workshop character with a polished professional finish'],
    fonts: 'Manrope for confident headlines · DM Sans for practical, highly readable information',
    colours: [{ name: 'Workshop green', value: '#183B32' }, { name: 'Signal lime', value: '#D8EF79' }, { name: 'Sage', value: '#AABB91' }, { name: 'Chalk', value: '#F7F7EF' }],
  },
  nails: {
    name: 'KT Nails & Spa',
    summary: 'A soft, polished salon concept built around calm, care and an everyday sense of luxury.',
    brief: 'Create a serene digital home that feels premium without becoming intimidating. The design should showcase treatments, communicate care and turn casual interest into confident bookings.',
    goals: ['Create an immediate feeling of calm and quality', 'Show treatments and pricing in an easy-to-scan format', 'Give photography enough space to sell the finish', 'Keep booking and salon information close at hand on every screen'],
    fonts: 'Manrope for clean structure · Fraunces Italic for a softer editorial accent',
    colours: [{ name: 'Blush', value: '#EAD6D1' }, { name: 'Mulberry', value: '#8C575B' }, { name: 'Espresso', value: '#493B38' }, { name: 'Porcelain', value: '#F7F6F1' }],
  },
};
---

<Layout
  title="Madhatter Studio — Distinctive websites for ambitious businesses"
  description="Madhatter Studio designs and builds sharp, strategic websites and brand experiences for ambitious businesses."
>
  <a class="skip-link" href="#main">Skip to content</a>

  <CommandBar />

  <main id="main">
    <section class="hero shell" id="top">
      <div class="hero-copy">
        <p class="eyebrow"><span></span> Independent design & development studio</p>
        <h1>Websites that make good businesses <em>impossible to ignore.</em></h1>
        <p class="hero-lead">Distinctive brand thinking, thoughtful web design and careful development—brought together into one sharp first impression.</p>
        <div class="hero-actions">
          <a class="button" href="#work">See selected work <span>↓</span></a>
          <a class="text-link" href="/enquire/">Tell us about your project <span>↗</span></a>
        </div>
      </div>

      <div class="studio-art" aria-label="Madhatter Studio design composition">
        <div class="art-label"><span>MADHATTER / 001</span><span>BRAND + DIGITAL</span></div>
        <div class="art-window">
          <div class="window-bar"><i></i><i></i><i></i></div>
          <div class="window-grid">
            <span class="shape-circle"></span>
            <span class="shape-card"></span>
            <span class="shape-line"></span>
            <strong>Ideas<br />made <em>visible.</em></strong>
          </div>
        </div>
        <div class="art-footer"><span>GOOD DESIGN GETS NOTICED.</span><span class="art-arrow">↗</span></div>
      </div>
    </section>

    <section class="principles shell" id="philosophy" aria-labelledby="principles-title">
      <div class="principles-heading">
        <p class="eyebrow">The thinking behind the work</p>
        <h2 id="principles-title">Three things we care about.</h2>
      </div>
      <div class="principle-grid">
        {principles.map((principle) => (
          <article class="principle">
            <span>{principle.number}</span>
            <div class={`principle-visual principle-visual-${principle.number}`} aria-hidden="true"><i></i><i></i><i></i></div>
            <h3>{principle.title}</h3>
            <p>{principle.text}</p>
          </article>
        ))}
      </div>
    </section>

    <section class="approach-section" id="approach" aria-labelledby="process-title">
      <div class="process shell">
        <div class="process-copy">
          <p class="eyebrow">How we work</p>
          <h2 id="process-title">Clear process.<br />No mystery.</h2>
          <p>Strategy, design and development stay connected from the first conversation to launch.</p>
        </div>
        <ol>
          <li><span>01</span><div><h3>Find the sharpest idea</h3><p>We clarify what makes the business valuable, who needs to care and what the website must achieve.</p></div></li>
          <li><span>02</span><div><h3>Build the visual world</h3><p>Direction, type, colour, imagery and layout come together into a system that feels genuinely yours.</p></div></li>
          <li><span>03</span><div><h3>Refine every detail</h3><p>We develop, test and polish the experience across screens until the whole thing feels effortless.</p></div></li>
        </ol>
      </div>
    </section>

    <section class="work-section" id="work">
      <div class="shell">
        <div class="section-heading">
          <div>
            <h2>Different businesses.<br /><em>Distinctive first impressions.</em></h2>
          </div>
          <p class="work-note">Each project has its own voice, audience and visual world. The common thread is clear thinking and a finish that feels considered.</p>
        </div>

        <article class="project-card project-curry">
          <div class="project-preview curry-preview">
            <img src="/projects/el-curry/plaza.png" alt="El Curry Loco illustrated plaza artwork" loading="lazy" />
            <div class="curry-browser">
              <div class="browser-top"><i></i><i></i><i></i><span>elcurryloco.co.uk</span></div>
              <div class="curry-page curry-page-render">
                <img class="curry-hero-image" src="/projects/el-curry/hero.png" alt="El Curry Loco website hero design" loading="lazy" />
              </div>
            </div>
            <span class="project-status">Open case study</span>
          </div>
          <div class="project-info">
            <div><div class="project-title-row"><h3>{projects.elCurryLoco.name}</h3><small class="project-disclaimer">Showcase concept · not client work</small></div><p>A bold, warm digital home for a restaurant bringing Mexican street food and Indian flavour together.</p></div>
            <ul><li>Brand positioning</li><li>Web design</li><li>Development</li></ul>
            <button class="case-study-trigger" type="button" data-case-study="curry">Read about the project <span>↗</span></button>
          </div>
        </article>

        <div class="project-pair">
          <article class="project-card project-fjd">
            <div class="project-preview fjd-preview">
              <div class="fjd-top"><span>FJD / WORKSHOP</span><span>SURBITON</span></div>
              <div class="fjd-wheel"><div><i></i><i></i><i></i><i></i><i></i><b>FJD</b></div></div>
              <div class="fjd-copy"><strong>Good care.<br />More miles<span>.</span></strong><small>READY FOR THE ROAD AHEAD&nbsp;&nbsp; ↗</small></div>
              <span class="project-status">Open case study</span>
            </div>
            <div class="project-info compact">
              <div><div class="project-title-row"><h3>{projects.fjdAutos.name}</h3><small class="project-disclaimer">Showcase concept · not client work</small></div><p>A cleaner, friendlier online presence for a trusted family-run garage.</p></div>
              <ul><li>Brand direction</li><li>Web design</li><li>Development</li></ul>
              <button class="case-study-trigger" type="button" data-case-study="fjd">Read about the project <span>↗</span></button>
            </div>
          </article>

          <article class="project-card project-nails">
            <div class="project-preview nails-preview">
              <div class="nails-copy"><span>A LITTLE TIME FOR YOU</span><strong>Make room<br />for <em>me-time.</em></strong></div>
              <div class="nails-photo"><img src="/projects/kt-nails/manicure.png" alt="French manicure created for the KT Nails website" loading="lazy" /></div>
              <div class="nails-brand">KT <em>Nails & Spa</em></div>
              <span class="project-status">Open case study</span>
            </div>
            <div class="project-info compact">
              <div><div class="project-title-row"><h3>{projects.ktNails.name}</h3><small class="project-disclaimer">Showcase concept · not client work</small></div><p>A soft, polished salon website built around calm, care and everyday luxury.</p></div>
              <ul><li>Brand direction</li><li>Web design</li><li>Development</li></ul>
              <button class="case-study-trigger" type="button" data-case-study="nails">Read about the project <span>↗</span></button>
            </div>
          </article>
        </div>
      </div>
    </section>

    <dialog class="case-study-modal" id="case-study-modal" aria-labelledby="case-study-title">
      <div class="case-study-panel">
        <button class="case-study-close" type="button" aria-label="Close case study">Close <span>×</span></button>
        <div class="case-study-heading">
          <p class="eyebrow">Case study</p>
          <h2 id="case-study-title"></h2>
          <p id="case-study-summary"></p>
        </div>
        <p class="case-study-notice"><strong>Showcase project.</strong> This is a self-initiated portfolio concept, not a commissioned client website or representation of a live client relationship.</p>
        <div class="case-study-grid">
          <section class="case-study-brief"><span>The brief</span><h3>What the idea needed to communicate</h3><p id="case-study-brief"></p></section>
          <section><span>Purpose</span><h3>The website needs to</h3><ul id="case-study-goals"></ul></section>
          <section><span>Visual system</span><h3>Colour and type</h3><div class="case-study-palette" id="case-study-palette"></div><p class="case-study-fonts" id="case-study-fonts"></p></section>
        </div>
      </div>
    </dialog>

    <script id="case-study-data" type="application/json" set:html={JSON.stringify(caseStudies)}></script>

    <section class="studio-section" id="studio">
      <div class="studio-grid shell">
        <div class="studio-card" aria-hidden="true">
          <span class="studio-card-label">MADHATTER / INDEPENDENT STUDIO</span>
          <div class="hat"><i></i><b></b><span></span></div>
          <strong>Curiosity<br />over convention.</strong>
        </div>
        <div class="studio-copy">
          <p class="eyebrow">03 / The studio</p>
          <h2>Small studio.<br /><em>High standards.</em></h2>
          <p>Madhatter is an independent creative studio helping ambitious businesses look as good as the work they do.</p>
          <p>You work directly with our studio throughout design and development. Fewer handovers, clearer decisions and a lot more care in the final result.</p>
          <a class="text-link" href="/enquire/">Let's talk about your project <span>↗</span></a>
        </div>
      </div>
    </section>

    <section class="final-cta shell">
      <div>
        <p class="eyebrow">Have something good in mind?</p>
        <h2>Let's make it<br /><em>look the part.</em></h2>
      </div>
      <a class="cta-orbit" href="/enquire/" aria-label="Start a project">
        <span>START A PROJECT</span><strong>↗</strong>
      </a>
    </section>
  </main>

  <footer class="site-footer shell">
    <div class="footer-brand">
      <a class="brand" href="#top" aria-label="Madhatter Studio, back to top"><span class="brand-word"><span>Mad</span><em>hatter</em></span><span class="brand-tag">Creative studio</span></a>
      <p>Distinctive websites for ambitious businesses.</p>
    </div>
    <div><h3>Start a conversation</h3><a href="/enquire/">Project enquiry ↗</a></div>
    <div><h3>Find us</h3><a href="#">Instagram ↗</a><a href="#">LinkedIn ↗</a></div>
    <small>© 2026 Madhatter Studio</small>
  </footer>

  <script>
    const modal = document.querySelector<HTMLDialogElement>('#case-study-modal');
    const dataElement = document.querySelector<HTMLScriptElement>('#case-study-data');

    if (modal && dataElement) {
      const studies = JSON.parse(dataElement.textContent || '{}') as Record<string, {
        name: string;
        summary: string;
        brief: string;
        goals: string[];
        fonts: string;
        colours: { name: string; value: string }[];
      }>;
      const setText = (selector: string, value: string) => {
        const element = modal.querySelector<HTMLElement>(selector);
        if (element) element.textContent = value;
      };

      document.querySelectorAll<HTMLButtonElement>('.case-study-trigger').forEach((trigger) => {
        trigger.addEventListener('click', () => {
          const study = studies[trigger.dataset.caseStudy || ''];
          if (!study) return;
          setText('#case-study-title', study.name);
          setText('#case-study-summary', study.summary);
          setText('#case-study-brief', study.brief);
          setText('#case-study-fonts', study.fonts);

          const goals = modal.querySelector<HTMLUListElement>('#case-study-goals');
          goals?.replaceChildren(...study.goals.map((goal) => Object.assign(document.createElement('li'), { textContent: goal })));

          const palette = modal.querySelector<HTMLElement>('#case-study-palette');
          palette?.replaceChildren(...study.colours.map((colour) => {
            const swatch = document.createElement('div');
            const chip = document.createElement('i');
            const label = document.createElement('span');
            const value = document.createElement('small');
            chip.style.background = colour.value;
            label.textContent = colour.name;
            value.textContent = colour.value;
            label.append(value);
            swatch.append(chip, label);
            return swatch;
          }));
          modal.showModal();
        });
      });

      modal.querySelector<HTMLButtonElement>('.case-study-close')?.addEventListener('click', () => modal.close());
      modal.addEventListener('click', (event) => { if (event.target === modal) modal.close(); });
    }
  </script>

</Layout>

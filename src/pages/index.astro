---
import Layout from '../layouts/Layout.astro';
import CommandBar from '../components/CommandBar.astro';
import { projects } from '../data/projects';

const principles = [
  {
    number: '01',
    title: 'Design shapes perception.',
    text: "It isn't decoration. It tells people whether a business is thoughtful, credible and worth their time.",
  },
  {
    number: '02',
    title: 'First impressions sell.',
    text: "You're not buying pages. You're creating the moment someone decides to trust you, choose you or keep scrolling.",
  },
  {
    number: '03',
    title: 'Details make the difference.',
    text: 'The type, spacing, interactions and mobile experience all contribute to how considered the finished brand feels.',
  },
  {
    number: '04',
    title: 'Individuality.',
    text: "Your business shouldn't look like everyone else's.",
  },
  {
    number: '05',
    title: 'Precision & Purpose.',
    text: 'Every interaction, type choice, transition and layout decision has a purpose.',
  },
  {
    number: '06',
    title: 'Commercial clarity.',
    text: 'Beautiful design should be effortless to use, easy to understand and built to turn interest into action.',
  },
];

const caseStudies = {
  curry: {
    name: 'El Curry Loco',
    images: [
      '/projects/el-curry/full_homepage.jpeg',
      '/projects/el-curry/menu_page.jpeg',
      '/projects/el-curry/enquiry form.png',
    ],
    url: projects.elCurryLoco.url,
    summary: 'A bold restaurant concept bringing Mexican street-food energy and Indian flavour together in one unmistakable digital identity.',
    brief: 'Create a lively, appetite-led website that explains the fusion immediately, feels independent rather than corporate, and gives a new restaurant a memorable first impression.',
    userAims: [
      'Understand the Mexican–Indian concept quickly',
      'Browse dishes, prices and dietary information',
      'Find opening hours and the restaurant location',
      'Order food or enquire about catering',
    ],
    goals: [
      'Make the Mexican–Indian concept instantly understandable',
      'Put signature food and personality at the centre',
      'Make menus, location details and ordering actions easy to find',
      'Translate the atmosphere cleanly across mobile and desktop',
    ],
    typography: [
      { role: 'Display heading', font: 'Manrope', style: 'Bold' },
      { role: 'Editorial accent', font: 'Fraunces', style: 'Semibold italic' },
      { role: 'Eyebrow', font: 'Manrope', style: 'Bold uppercase' },
      { role: 'Body and UI', font: 'Manrope', style: 'Regular / semibold' },
    ],
    colourGroups: [
      {
        label: 'Primary brand colours',
        colours: [
          { name: 'Terracotta', value: '#d35738' },
          { name: 'Peach', value: '#e79570' },
          { name: 'Saffron', value: '#f3b339' },
        ],
      },
      { label: 'Supporting colours', colours: [{ name: 'Forest', value: '#314e39' }] },
      {
        label: 'Typography colours',
        colours: [
          { name: 'Cream', value: '#f4c899' },
          { name: 'Cocoa', value: '#3d271e' },
        ],
      },
    ],
  },
  fjd: {
    name: 'FJD Autos',
    images: [
      '/projects/fjd-autos/fjd_homepage.jpeg',
      '/projects/fjd-autos/fjd_enquiry.jpeg',
    ],
    url: projects.fjdAutos.url,
    summary: 'A cleaner, friendlier workshop identity designed to make a trusted family-run garage feel as dependable online as it does in person.',
    brief: 'Reframe an independent garage around clarity, trust and long-term care. The website needs to reassure drivers, explain services without jargon and make booking feel straightforward.',
    userAims: [
      'See which repairs and services are available',
      'Feel confident the garage is experienced and trustworthy',
      'Request a booking without unnecessary back-and-forth',
      'Find the phone number, address and opening hours',
    ],
    goals: [
      'Build trust before a customer picks up the phone',
      'Present services in clear, everyday language',
      'Make location, opening hours and booking details effortless to find',
      'Balance workshop character with a polished professional finish',
    ],
    typography: [
      { role: 'Display heading', font: 'Manrope', style: 'Bold' },
      { role: 'Section heading', font: 'Manrope', style: 'Medium' },
      { role: 'Eyebrow', font: 'Manrope', style: 'Bold uppercase' },
      { role: 'Body and UI', font: 'DM Sans', style: 'Regular / semibold' },
    ],
    colourGroups: [
      {
        label: 'Primary brand colours',
        colours: [
          { name: 'Workshop green', value: '#164231' },
          { name: 'Signal lime', value: '#d9e558' },
        ],
      },
      { label: 'Supporting colours', colours: [{ name: 'Pale sage', value: '#ddd8b0' }] },
      {
        label: 'Typography colours',
        colours: [
          { name: 'Warm chalk', value: '#f4e7c4' },
          { name: 'Muted grey', value: '#6e6d59' },
        ],
      },
    ],
  },
  nails: {
    name: 'LX Nails & Spa',
    images: [
      '/projects/kt-nails/nails_fullhomepage.jpeg',
      '/projects/kt-nails/manicure.png',
    ],
    url: projects.ktNails.url,
    summary: 'A soft, polished salon concept built around calm, care and an everyday sense of luxury.',
    brief: 'Create a serene digital home that feels premium without becoming intimidating. The design should showcase treatments, communicate care and turn casual interest into confident bookings.',
    userAims: [
      'Browse treatments and understand what is offered',
      'See examples of the salon’s work and finish',
      'Find prices, availability and booking information',
      'Locate the salon and plan a visit confidently',
    ],
    goals: [
      'Create an immediate feeling of calm and quality',
      'Show treatments and pricing in an easy-to-scan format',
      'Give photography enough space to sell the finish',
      'Keep booking and salon information close at hand on every screen',
    ],
    typography: [
      { role: 'Display heading', font: 'Cormorant Garamond', style: 'Regular' },
      { role: 'Editorial accent', font: 'Cormorant Garamond', style: 'Italic' },
      { role: 'Eyebrow', font: 'DM Sans', style: 'Medium uppercase' },
      { role: 'Body and UI', font: 'DM Sans', style: 'Regular / medium' },
    ],
    colourGroups: [
      {
        label: 'Primary brand colours',
        colours: [
          { name: 'Blush', value: '#e8c9ae' },
          { name: 'Dusty rose', value: '#9b5c55' },
        ],
      },
      { label: 'Supporting colours', colours: [{ name: 'Warm taupe', value: '#c5ad8c' }] },
      {
        label: 'Typography colours',
        colours: [
          { name: 'Porcelain', value: '#f7e6c6' },
          { name: 'Espresso', value: '#46332c' },
        ],
      },
    ],
  },
};
---

<Layout
  title="Madhatter Studio — Distinctive websites for ambitious businesses"
  description="Madhatter Studio designs and builds sharp, strategic websites and brand experiences for ambitious businesses."
>
  <CommandBar />

  <main id="main">
    <section class="hero shell" id="top">
      <div class="hero-copy">
        <p class="eyebrow"><span></span> Independent design & development studio</p>
        <h1>Websites that make good businesses <em>impossible to ignore.</em></h1>
        <p class="hero-lead">No templates. No forgettable first impressions. Just distinctive design, thoughtful development and an obsession with the little details that make a website feel extraordinary.</p>
        <div class="hero-actions">
          <a class="button" href="/enquire/">Tell us about your project <span>&#x2197;&#xFE0E;</span></a>
          <a class="text-link" href="#work">See selected work <span>&#x2193;&#xFE0E;</span></a>
        </div>
      </div>

      <div class="studio-art" aria-label="Madhatter Studio design composition">
        <div class="art-label"><span>MADHATTER</span><span>DIGITAL BRANDING</span></div>
        <div class="art-window">
          <div class="window-bar"><i></i><i></i><i></i></div>
          <div class="window-grid">
            <span class="shape-circle"></span>
            <span class="shape-card"></span>
            <span class="shape-line"><i></i><i></i><i></i></span>
            <strong><span class="art-word">Ideas</span><br /><span class="art-word">made</span> <em class="art-word">visible.</em></strong>
          </div>
        </div>
        <div class="art-footer"><span>GOOD DESIGN GETS NOTICED.</span><a class="art-arrow" href="#work" aria-label="See selected work">&#x2197;&#xFE0E;</a></div>
      </div>
    </section>

    <section class="principles shell" id="philosophy" aria-labelledby="principles-title">
      <div class="principles-heading">
        <p class="eyebrow">The thinking behind the work</p>
        <h2 id="principles-title">The little things are the big things.</h2>
        <p class="principles-intro">The spacing. The typography. The way a page moves. The feeling you get before you've even read a word.
        We believe the difference between a website that looks good and one that feels exceptional lives in the details.</p>
      </div>
      <div class="principle-grid">
        {principles.map((principle) => (
          <article class="principle">
            <div class={`principle-visual principle-visual-${principle.number}`} aria-hidden="true"><i></i><i></i><i></i></div>
            <h3>{principle.title}</h3>
            <p>{principle.text}</p>
          </article>
        ))}
      </div>
    </section>

    <section class="studio-collab-section" aria-labelledby="studio-collab-title">
      <div class="studio-collab shell">
        <div>
          <h3 id="studio-collab-title">Design and development,<br /><em>working together from day one.</em></h3>
        </div>
        <p>A joined approach means fewer handovers, clearer decisions and a smoother journey from first idea to final result.</p>
      </div>
    </section>

    <section class="approach-section" id="approach" aria-labelledby="process-title">
      <div class="process shell">
        <div class="process-copy">
          <p class="eyebrow">How we work</p>
          <h2 id="process-title">Clear process.<br /><em class="process-swoosh">No mystery.</em></h2>
          <p>
            Good design isn't guesswork. We explore the possibilities, make deliberate decisions and refine every detail until the whole experience feels effortless.
          </p>
        </div>
        <ol class="process-steps">
          <li>
            <span>01</span>
            <div>
              <div class="process-card-meta">
                <p class="process-card-eyebrow">Discovery & Strategy</p>
                <span class="process-duration">1 day</span>
              </div>
              <h3>First, we get to know you and your business</h3>
              <p>We learn what makes your business different, who you're trying to reach and what your website needs to achieve.</p>
            </div>
          </li>
          <li>
            <span>02</span>
            <div>
              <div class="process-card-meta">
                <p class="process-card-eyebrow">Plan of action</p>
                <span class="process-duration">1–2 days</span>
              </div>
              <h3>A plan that's yours</h3>
              <p>We recommend the right features, structure and approach for your goals, priorities and budget with a personalised timeline for delivery.</p>
              <p>We shape the plan together, so you're investing in what your business actually needs.</p>
            </div>
          </li>
          <li>
            <span>03</span>
            <div>
              <div class="process-card-meta">
                <p class="process-card-eyebrow">Design & Creative direction</p>
                <span class="process-duration">3 days</span>
              </div>
              <h3>Your vision, taking shape.</h3>
              <p>See the first design direction in around three working days. Something real to react to, refine and make your own.</p>
              <p>Direction, type, colour, imagery and layout come together into a system that feels genuinely yours.</p>
            </div>
          </li>
          <li>
            <span>04</span>
            <div>
              <div class="process-card-meta">
                <p class="process-card-eyebrow">Build &amp; Launch</p>
                <span class="process-duration">5 days</span>
              </div>
              <h3>Made real. Made right. From a concept to live website.</h3>
              <p>We develop, test and polish the experience across screens until the whole thing feels effortless.</p>
            </div>
          </li>
        </ol>
      </div>
    </section>

    <section class="work-section" id="work">
      <div class="shell">
        <div class="section-heading">
          <div>
            <h2>Different businesses.<br /><em>Distinctive first impressions.</em></h2>
          </div>
          <p class="work-note">Each project has its own voice, audience and visual world. The common thread is clear thinking and a finish that feels considered.</p>
        </div>

        <article class="project-card project-curry">
          <div class="project-preview curry-preview">
            <img src="/projects/el-curry/plaza.png" alt="El Curry Loco illustrated plaza artwork" loading="lazy" />
            <div class="curry-browser">
              <div class="browser-top"><i></i><i></i><i></i><span>elcurryloco.co.uk</span></div>
              <div class="curry-page curry-page-render">
                <img class="curry-hero-image" src="/projects/el-curry/hero.png" alt="El Curry Loco website hero design" loading="lazy" />
                <div class="curry-mobile-hero">
                  <p>Mexican spirit · Indian soul</p>
                  <h3>Two cultures.<br /><em>One loco kitchen.</em></h3>
                  <img src="/projects/el-curry/food.png" alt="Tacos, curry, burrito bowl and Jarritos drinks" loading="lazy" />
                </div>
              </div>
            </div>
            <button class="project-status" type="button" data-case-study="curry">Open case study</button>
          </div>
          <div class="project-info">
            <div>
              <div class="project-title-row">
                <h3>{projects.elCurryLoco.name}</h3>
                <small class="project-disclaimer">Showcase concept · not client work</small>
              </div>
              <p>A bold, warm digital home for a restaurant bringing Mexican street food and Indian flavour together.</p>
            </div>
            <ul>
              <li>Brand positioning</li>
              <li>Web design</li>
              <li>Development</li>
            </ul>
          </div>
        </article>

        <div class="project-pair">
          <article class="project-card project-fjd">
            <div class="project-preview fjd-preview">
              <div class="fjd-top">
                <span>FJD / WORKSHOP</span>
                <span>SURBITON</span>
              </div>
              <div class="fjd-wheel">
                <div><i></i><i></i><i></i><i></i><i></i><b>FJD</b></div>
              </div>
              <div class="fjd-copy">
                <strong>Good care.<br />More miles<span>.</span></strong>
                <small>READY FOR THE ROAD AHEAD&nbsp;&nbsp; &#x2197;&#xFE0E;</small>
              </div>
              <button class="project-status" type="button" data-case-study="fjd">Open case study</button>
            </div>
            <div class="project-info compact">
              <div>
                <div class="project-title-row">
                  <h3>{projects.fjdAutos.name}</h3>
                  <small class="project-disclaimer">Showcase concept · not client work</small>
                </div>
                <p>A cleaner, friendlier online presence for a trusted family-run garage.</p>
              </div>
              <ul>
                <li>Brand direction</li>
                <li>Web design</li>
                <li>Development</li>
              </ul>
            </div>
          </article>

          <article class="project-card project-nails">
            <div class="project-preview nails-preview">
              <div class="nails-copy">
                <span>A LITTLE TIME FOR YOU</span>
                <strong>Make room<br />for <em>me-time.</em></strong>
              </div>
              <div class="nails-photo">
                <img src="/projects/kt-nails/manicure.png" alt="French manicure created for the LX Nails website" loading="lazy" />
              </div>
              <div class="nails-brand">LX <em>Nails & Spa</em></div>
              <button class="project-status" type="button" data-case-study="nails">Open case study</button>
            </div>
            <div class="project-info compact">
              <div>
                <div class="project-title-row">
                  <h3>{projects.ktNails.name}</h3>
                  <small class="project-disclaimer">Showcase concept · not client work</small>
                </div>
                <p>A soft, polished salon website built around calm, care and everyday luxury.</p>
              </div>
              <ul>
                <li>Brand direction</li>
                <li>Web design</li>
                <li>Development</li>
              </ul>
            </div>
          </article>
        </div>
      </div>
    </section>

    <dialog class="case-study-modal" id="case-study-modal" aria-labelledby="case-study-title">
      <div class="case-study-panel">
        <button class="case-study-close" type="button" aria-label="Close case study">
          <span>×</span>
        </button>
        <p class="case-study-notice">
          <strong>Showcase project.</strong> This is a self-initiated portfolio concept, not a commissioned client website or representation of a live client relationship.
        </p>
        <div class="case-study-heading">
          <div class="case-study-heading-column">
            <div class="case-study-identity">
              <p class="eyebrow">Case study</p>
              <h2 id="case-study-title"></h2>
              <a id="case-study-website" class="case-study-website" target="_blank" rel="noreferrer">
                Visit website <strong>&#x2197;&#xFE0E;</strong>
              </a>
            </div>
            <div class="case-study-overview">
              <span>Project overview</span>
              <p id="case-study-summary"></p>
            </div>
            <section class="case-study-user-aims">
              <span>User aims</span>
              <h3>What visitors need to do</h3>
              <ul id="case-study-user-aims"></ul>
            </section>
            <aside class="case-study-colour-card">
              <span>Colour system</span>
              <div class="case-study-palette" id="case-study-palette"></div>
            </aside>
          </div>
          <div class="case-study-heading-column">
            <section class="case-study-brief">
              <span>The brief</span>
              <h3>What the idea needed to communicate</h3>
              <p id="case-study-brief"></p>
            </section>
            <section class="case-study-purpose-card">
              <span>Purpose</span>
              <h3>The website needs to</h3>
              <ul id="case-study-goals"></ul>
            </section>
            <section class="case-study-typography-card">
              <span>Typography &amp; type hierarchy</span>
              <div class="case-study-type-table" id="case-study-type-table"></div>
            </section>
          </div>
        </div>
        <section class="case-study-visual-showcase">
          <div class="case-study-gallery" id="case-study-gallery"></div>
        </section>
      </div>
    </dialog>

    <script id="case-study-data" type="application/json" set:html={JSON.stringify(caseStudies)}></script>

    <section class="studio-section" id="studio">
      <div class="studio-grid shell">
        <div class="studio-card" aria-hidden="true">
          <span class="studio-card-label">INDEPENDENT<br />CREATIVE STUDIO</span>
          <div class="hat"><i></i><b></b><span></span></div>
          <strong>Curiosity<br />over convention.</strong>
        </div>
        <div class="studio-copy">
          <h2>Small studio.<br /><em>High standards.</em></h2>
          <p>
            Mad Hatter is an independent creative studio for businesses that want more than a website that simply works.
          </p>
          <div class="studio-values">
            <article>
              <h3>Bold<br />ideas<span>.</span></h3>
              <p>Not another website that looks like everyone else's.</p>
            </article>
            <article>
              <h3>Careful<br /><span class="craft-accent">craft</span>sman&shy;ship.</h3>
              <p>Thoughtfully designed. Beautifully built.</p>
            </article>
            <article class="studio-value-accent">
              <h3><span class="orange-a">A</span>n unre<span class="orange-a">a</span>son<span class="orange-a">a</span>ble <span class="orange-a">a</span>ppreciation for the finer det<span class="orange-a">a</span>ils.</h3>
              <p>Because memorable isn't accidental.</p>
            </article>
          </div>
        </div>
      </div>
    </section>

    <section class="final-cta shell">
      <div class="final-desktop">
        <div class="final-copy">
          <p class="eyebrow">Everything starts somewhere</p>
          <h2><span>Let's make</span><span>it look</span><span>the part.</span></h2>
          <span class="final-scribble" aria-hidden="true"></span>
          <a class="cta-orbit" href="/enquire/" aria-label="Start a conversation">
            <span class="cta-label">Start a conversation</span>
            <strong><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 12h13M13 7l5 5-5 5"></path></svg></strong>
          </a>
        </div>
        <div class="final-playground">
          <button class="hat final-hat" type="button" aria-label="Show another idea"><span class="final-hat-shape"><i></i><b></b><span></span></span></button>
          <div class="final-note"><small>A little Mad Hatter invitation</small><span class="final-note-text">You bring the wishlist. Call us Santa Claus.</span></div>
          <svg class="final-orbit" viewBox="0 0 300 310" aria-hidden="true">
            <path class="final-orbit-default" d="M18 296 C 8 168 104 66 288 62"></path>
            <path class="final-orbit-tablet" d="M18 302 C 2 210 54 132 142 112 C 208 96 262 124 288 168"></path>
          </svg>
          <i class="final-shape final-shape-orange" aria-hidden="true"></i>
          <i class="final-shape final-shape-acid" aria-hidden="true"></i>
          <i class="final-shape final-shape-paper" aria-hidden="true"></i>
          <i class="final-shape final-shape-lilac" aria-hidden="true"></i>
        </div>
      </div>
      <div class="final-mobile">
        <div>
          <p class="eyebrow">Everything starts somewhere</p>
          <div class="final-mobile-heading-row">
            <h2><span>Let's make</span><span>it look</span><span>the part.</span></h2>
            <a class="final-mobile-arrow" href="/enquire/" aria-label="Start a conversation">
              <svg viewBox="0 0 40 24" aria-hidden="true">
                <path class="arrow-outline" d="M2 12h35M29 4l8 8-8 8"></path>
                <path class="arrow-core" d="M2 12h35M29 4l8 8-8 8"></path>
              </svg>
            </a>
          </div>
          <span class="final-scribble" aria-hidden="true"></span>
        </div>
      </div>
    </section>
  </main>

  <footer class="site-footer shell">
    <div class="footer-brand">
      <a class="brand" href="#top" aria-label="Madhatter Studio, back to top">
        <span class="brand-word"><span>Mad</span><em>hatter</em></span>
        <span class="brand-tag">Creative studio</span>
      </a>
      <p>Distinctive websites for ambitious businesses.</p>
    </div>
    <div>
      <h3>Start a conversation</h3>
      <a href="/enquire/">Project enquiry &#x2197;&#xFE0E;</a>
    </div>
    <div>
      <h3>Find us</h3>
      <a href="#">Instagram &#x2197;&#xFE0E;</a>
      <a href="#">LinkedIn &#x2197;&#xFE0E;</a>
    </div>
    <small>© 2026 Madhatter Studio</small>
  </footer>

  <script>
    const modal = document.querySelector<HTMLDialogElement>('#case-study-modal');
    const dataElement = document.querySelector<HTMLScriptElement>('#case-study-data');

    if (modal && dataElement) {
      const studies = JSON.parse(dataElement.textContent || '{}') as Record<string, {
        name: string;
        images: string[];
        url: string;
        summary: string;
        brief: string;
        userAims: string[];
        goals: string[];
        typography: { role: string; font: string; style: string }[];
        colourGroups: { label: string; colours: { name: string; value: string }[] }[];
      }>;
      const setText = (selector: string, value: string) => {
        const element = modal.querySelector<HTMLElement>(selector);
        if (element) element.textContent = value;
      };

      document.querySelectorAll<HTMLButtonElement>('.project-status[data-case-study]').forEach((trigger) => {
        trigger.addEventListener('click', () => {
          const study = studies[trigger.dataset.caseStudy || ''];
          if (!study) return;
          setText('#case-study-title', study.name);
          setText('#case-study-summary', study.summary);
          setText('#case-study-brief', study.brief);

          const gallery = modal.querySelector<HTMLElement>('#case-study-gallery');
          const galleryColumns = Array.from({ length: Math.min(3, study.images.length) }, () => {
            const column = document.createElement('div');
            column.className = 'case-study-gallery-column';
            return column;
          });
          study.images.forEach((source, index) => {
            const frame = document.createElement('figure');
            const image = document.createElement('img');
            image.src = source;
            image.alt = `${study.name} website design view ${index + 1}`;
            frame.append(image);
            galleryColumns[index % galleryColumns.length]?.append(frame);
          });
          gallery?.replaceChildren(...galleryColumns);
          const website = modal.querySelector<HTMLAnchorElement>('#case-study-website');
          if (website) {
            if (study.url) {
              website.href = study.url;
              website.removeAttribute('aria-disabled');
              website.classList.remove('is-disabled');
            } else {
              website.removeAttribute('href');
              website.setAttribute('aria-disabled', 'true');
              website.classList.add('is-disabled');
            }
          }

          const goals = modal.querySelector<HTMLUListElement>('#case-study-goals');
          goals?.replaceChildren(...study.goals.map((goal) => Object.assign(document.createElement('li'), { textContent: goal })));

          const userAims = modal.querySelector<HTMLUListElement>('#case-study-user-aims');
          userAims?.replaceChildren(...study.userAims.map((aim) => Object.assign(document.createElement('li'), { textContent: aim })));

          const palette = modal.querySelector<HTMLElement>('#case-study-palette');
          palette?.replaceChildren(...study.colourGroups.map((group) => {
            const section = document.createElement('section');
            const heading = document.createElement('h4');
            const swatches = document.createElement('div');
            heading.textContent = group.label;
            swatches.className = 'case-study-colour-swatches';
            swatches.append(...group.colours.map((colour) => {
              const swatch = document.createElement('div');
              const chip = document.createElement('i');
              const label = document.createElement('span');
              const value = document.createElement('small');
              chip.style.background = colour.value;
              label.textContent = colour.name;
              value.textContent = colour.value;
              label.append(value);
              swatch.append(chip, label);
              return swatch;
            }));
            section.append(heading, swatches);
            return section;
          }));
          const typeTable = modal.querySelector<HTMLElement>('#case-study-type-table');
          typeTable?.replaceChildren(...study.typography.map((type) => {
            const row = document.createElement('div');
            const role = document.createElement('span');
            const font = document.createElement('strong');
            const style = document.createElement('small');
            const example = document.createElement('em');
            role.textContent = type.role;
            font.textContent = type.font;
            style.textContent = type.style;
            const examples: Record<string, string> = {
              'Display heading': 'Distinctive by design.',
              'Section heading': 'Clear thinking, clearly made.',
              'Editorial accent': 'Made memorable.',
              'Eyebrow': 'A SHARPER FIRST IMPRESSION',
              'Body and UI': 'Thoughtful details, clearly communicated.',
            };
            example.textContent = examples[type.role] || 'Ideas made visible.';
            example.className = 'case-study-type-example';
            example.dataset.role = type.role;
            example.style.fontFamily = `"${type.font}", ${type.font.includes('Fraunces') || type.font.includes('Cormorant') ? 'serif' : 'sans-serif'}`;
            example.style.fontStyle = type.style.toLowerCase().includes('italic') ? 'italic' : 'normal';
            example.style.fontWeight = type.style.toLowerCase().includes('bold') ? '700' : type.style.toLowerCase().includes('semibold') ? '600' : type.style.toLowerCase().includes('medium') ? '500' : '400';
            row.append(role, font, style, example);
            return row;
          }));
          modal.showModal();
        });
      });

      modal.querySelector<HTMLButtonElement>('.case-study-close')?.addEventListener('click', () => modal.close());
      modal.addEventListener('click', (event) => { if (event.target === modal) modal.close(); });
    }

    const processSteps = document.querySelector<HTMLOListElement>('.process-steps');

    if (processSteps) {
      const markers = Array.from(processSteps.querySelectorAll<HTMLElement>(':scope > li > span'));
      let timelineFrame = 0;
      let measurementFrame = 0;
      let listPageTop = 0;
      let sectionPageTop = 0;
      let markerCentres: number[] = [];
      let finalStepEnd = 0;
      let previousProgress = -1;
      let previousReachedMarker = -2;
      let previousCurrentMarker = -2;
      const getTimelineViewportRatio = () => window.innerWidth <= 700 ? 0.32 : 0.4;

      const updateProcessTimeline = () => {
        timelineFrame = 0;
        if (!markerCentres.length) return;

        const timelineStart = markerCentres[0];
        const timelineEnd = markerCentres[markerCentres.length - 1];
        const scrollPlayhead = window.scrollY + window.innerHeight * getTimelineViewportRatio() - listPageTop;
        const progress = Math.round(
          Math.max(0, Math.min(timelineEnd - timelineStart, scrollPlayhead - timelineStart)) * 2,
        ) / 2;

        if (progress !== previousProgress) {
          processSteps.style.setProperty('--timeline-progress', `${progress}px`);
          previousProgress = progress;
        }

        let reachedMarker = -1;
        markerCentres.forEach((centre, index) => {
          if (scrollPlayhead >= centre) reachedMarker = index;
        });
        let currentMarker = reachedMarker;
        if (scrollPlayhead >= finalStepEnd) currentMarker = -1;

        if (reachedMarker !== previousReachedMarker) {
          markers.forEach((marker, index) => marker.classList.toggle('is-reached', index <= reachedMarker));
          previousReachedMarker = reachedMarker;
        }
        if (currentMarker !== previousCurrentMarker) {
          markers.forEach((marker, index) => marker.classList.toggle('is-current', index === currentMarker));
          previousCurrentMarker = currentMarker;
        }
      };

      const scheduleProcessTimeline = () => {
        if (!timelineFrame) timelineFrame = window.requestAnimationFrame(updateProcessTimeline);
      };

      const measureProcessTimeline = () => {
        measurementFrame = 0;
        if (!markers.length) return;

        const listRect = processSteps.getBoundingClientRect();
        const sectionRect = processSteps.closest<HTMLElement>('.approach-section')?.getBoundingClientRect();
        listPageTop = window.scrollY + listRect.top;
        sectionPageTop = window.scrollY + (sectionRect?.top ?? listRect.top);
        markerCentres = markers.map((marker) => {
          const markerRect = marker.getBoundingClientRect();
          return markerRect.top + markerRect.height / 2 - listRect.top;
        });
        const finalStep = markers[markers.length - 1].closest('li');
        finalStepEnd = finalStep
          ? finalStep.getBoundingClientRect().bottom - listRect.top
          : markerCentres[markerCentres.length - 1];

        processSteps.style.setProperty('--timeline-top', `${markerCentres[0]}px`);
        processSteps.style.setProperty('--timeline-length', `${markerCentres[markerCentres.length - 1] - markerCentres[0]}px`);
        previousProgress = -1;
        updateProcessTimeline();
      };

      const scheduleProcessMeasurement = () => {
        if (!measurementFrame) measurementFrame = window.requestAnimationFrame(measureProcessTimeline);
      };

      window.addEventListener('scroll', scheduleProcessTimeline, { passive: true });
      window.addEventListener('resize', scheduleProcessMeasurement);
      new ResizeObserver(scheduleProcessMeasurement).observe(processSteps);

      processSteps.querySelectorAll<HTMLElement>(':scope > li > div').forEach((card, index) => {
        card.tabIndex = 0;
        card.setAttribute('role', 'button');
        card.setAttribute('aria-label', `Go to step ${index + 1}`);

        const goToStep = () => {
          const markerCentre = markerCentres[index];
          if (markerCentre === undefined) return;

          let targetTop = listPageTop + markerCentre - window.innerHeight * getTimelineViewportRatio();
          if (index === 0) targetTop = sectionPageTop;
          if (index > 0) targetTop += 2;

          window.scrollTo({
            top: targetTop,
            behavior: window.matchMedia('(prefers-reduced-motion: reduce)').matches ? 'auto' : 'smooth',
          });
        };

        card.addEventListener('click', goToStep);
        card.addEventListener('keydown', (event) => {
          if (event.key !== 'Enter' && event.key !== ' ') return;
          event.preventDefault();
          goToStep();
        });
      });

      scheduleProcessMeasurement();
    }

    const finalNote = document.querySelector<HTMLElement>('.final-note');
    const finalNoteText = finalNote?.querySelector<HTMLElement>('.final-note-text');
    const finalHat = document.querySelector<HTMLButtonElement>('.final-hat');

    if (finalNote && finalNoteText && finalHat) {
      const phrases = [
        'You bring the wishlist. Call us Santa Claus.',
        'Cinderella, meet your fairy godmother.',
        'A little different? Even better',
        'Your wishlist.\nOur pleasure.',
        'Your business. Anything but ordinary.',
        'Consider your needs met.',
        "Let's make something worth remembering.",
        'Big ideas welcome. Small ones too.',
        "No vision yet? That's our kind of challenge.",
        'Every little detail. Deliberately done',
      ];
      const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
      let phraseOrder: string[] = [];
      let phraseIndex = 0;
      let lastPhrase = '';
      let rotationTimer = 0;
      let fadeTimer = 0;
      let isNoteVisible = false;

      const shufflePhrases = () => {
        phraseOrder = [...phrases];
        for (let index = phraseOrder.length - 1; index > 0; index -= 1) {
          const randomIndex = Math.floor(Math.random() * (index + 1));
          [phraseOrder[index], phraseOrder[randomIndex]] = [phraseOrder[randomIndex], phraseOrder[index]];
        }
        if (phraseOrder[0] === lastPhrase && phraseOrder.length > 1) {
          [phraseOrder[0], phraseOrder[1]] = [phraseOrder[1], phraseOrder[0]];
        }
        phraseIndex = 0;
      };

      const takeNextPhrase = () => {
        if (phraseIndex >= phraseOrder.length) shufflePhrases();
        const phrase = phraseOrder[phraseIndex];
        phraseIndex += 1;
        lastPhrase = phrase;
        return phrase;
      };

      const scheduleNoteChange = () => {
        window.clearTimeout(rotationTimer);
        if (isNoteVisible) rotationTimer = window.setTimeout(showNextPhrase, 7000);
      };

      const showNextPhrase = () => {
        window.clearTimeout(rotationTimer);
        window.clearTimeout(fadeTimer);
        finalNoteText.classList.add('is-changing');
        fadeTimer = window.setTimeout(() => {
          finalNoteText.textContent = takeNextPhrase();
          finalNoteText.classList.remove('is-changing');
          scheduleNoteChange();
        }, reducedMotion.matches ? 0 : 180);
      };

      finalHat.addEventListener('click', showNextPhrase);
      shufflePhrases();
      finalNoteText.textContent = takeNextPhrase();

      const noteObserver = new IntersectionObserver(([entry]) => {
        isNoteVisible = entry.isIntersecting;
        window.clearTimeout(rotationTimer);
        window.clearTimeout(fadeTimer);
        finalNoteText.classList.remove('is-changing');
        if (isNoteVisible) scheduleNoteChange();
      }, { threshold: 0.35 });
      noteObserver.observe(finalNote);
    }

    document.querySelectorAll<HTMLElement>('.studio-art, .art-word, .shape-circle, .shape-card, .final-hat, .final-note, .final-shape, .cta-orbit').forEach((interactive) => {
      let tapTimer = 0;
      interactive.addEventListener('pointerdown', () => {
        interactive.classList.remove('is-tapped');
        void interactive.offsetWidth;
        interactive.classList.add('is-tapped');
        window.clearTimeout(tapTimer);
        tapTimer = window.setTimeout(() => interactive.classList.remove('is-tapped'), 650);
      });
    });

    document.querySelectorAll<HTMLElement>('.shape-line i').forEach((line) => {
      line.addEventListener('pointerenter', () => {
        line.classList.remove('is-swinging');
        void line.offsetWidth;
        line.classList.add('is-swinging');
      });
      line.addEventListener('pointerdown', () => {
        line.classList.remove('is-swinging');
        void line.offsetWidth;
        line.classList.add('is-swinging');
      });
      line.addEventListener('animationend', () => line.classList.remove('is-swinging'));
    });
  </script>

</Layout>

---
import Layout from '../layouts/Layout.astro';
import CommandBar from '../components/CommandBar.astro';
import { projects } from '../data/projects';

const principles = [
  {
    number: '01',
    title: 'Design shapes perception.',
    text: "It isn't decoration. It tells people whether a business is thoughtful, credible and worth their time.",
  },
  {
    number: '02',
    title: 'First impressions sell.',
    text: "You're not buying pages. You're creating the moment someone decides to trust you, choose you or keep scrolling.",
  },
  {
    number: '03',
    title: 'Details make the difference.',
    text: 'The type, spacing, interactions and mobile experience all contribute to how considered the finished brand feels.',
  },
];
---

<Layout
  title="Madhatter Studio — Distinctive websites for ambitious businesses"
  description="Madhatter Studio designs and builds sharp, strategic websites and brand experiences for ambitious businesses."
>
  <a class="skip-link" href="#main">Skip to content</a>

  <CommandBar />

  <main id="main">
    <section class="hero shell" id="top">
      <div class="hero-copy">
        <p class="eyebrow"><span></span> Independent design & development studio</p>
        <h1>Websites that make good businesses <em>impossible to ignore.</em></h1>
        <p class="hero-lead">Distinctive brand thinking, thoughtful web design and careful development—brought together into one sharp first impression.</p>
        <div class="hero-actions">
          <a class="button" href="#work">See selected work <span>↓</span></a>
          <a class="text-link" href="/enquire/">Tell me about your project <span>↗</span></a>
        </div>
      </div>

      <div class="studio-art" aria-label="Madhatter Studio design composition">
        <div class="art-label"><span>MADHATTER / 001</span><span>BRAND + DIGITAL</span></div>
        <div class="art-window">
          <div class="window-bar"><i></i><i></i><i></i></div>
          <div class="window-grid">
            <span class="shape-circle"></span>
            <span class="shape-card"></span>
            <span class="shape-line"></span>
            <strong>Ideas<br />made <em>visible.</em></strong>
          </div>
        </div>
        <div class="art-footer"><span>GOOD DESIGN GETS NOTICED.</span><span class="art-arrow">↗</span></div>
      </div>
    </section>

    <section class="principles shell" id="approach" aria-labelledby="principles-title">
      <div class="principles-heading">
        <p class="eyebrow">The thinking behind the work</p>
        <h2 id="principles-title">Three things I care about.</h2>
      </div>
      <div class="principle-grid">
        {principles.map((principle) => (
          <article class="principle">
            <span>{principle.number}</span>
            <h3>{principle.title}</h3>
            <p>{principle.text}</p>
          </article>
        ))}
      </div>
    </section>

    <section class="work-section" id="work">
      <div class="shell">
        <div class="section-heading">
          <div>
            <p class="eyebrow">01 / Selected work</p>
            <h2>Different businesses.<br /><em>Distinctive first impressions.</em></h2>
          </div>
          <p>Each project has its own voice, audience and visual world. The common thread is clear thinking and a finish that feels considered.</p>
        </div>

        <article class="project-card project-curry">
          <div class="project-preview curry-preview">
            <img src="/projects/el-curry/plaza.png" alt="El Curry Loco illustrated plaza artwork" loading="lazy" />
            <div class="curry-browser">
              <div class="browser-top"><i></i><i></i><i></i><span>elcurryloco.co.uk</span></div>
              <div class="curry-page">
                <div class="curry-brand">EL CURRY<br />LOCO</div>
                <p>MEXICAN SPIRIT · INDIAN SOUL</p>
                <h3>Two cultures.<br /><em>One loco kitchen.</em></h3>
                <img src="/projects/el-curry/food.png" alt="" />
              </div>
            </div>
          </div>
          <div class="project-info">
            <span class="project-number">01</span>
            <div><h3>{projects.elCurryLoco.name}</h3><p>A bold, warm digital home for a restaurant bringing Mexican street food and Indian flavour together.</p></div>
            <ul><li>Brand direction</li><li>Web design</li><li>Development</li></ul>
            {projects.elCurryLoco.url ? <a class="project-link" href={projects.elCurryLoco.url} target="_blank" rel="noreferrer">View live site ↗</a> : <span class="project-status">Live site coming soon</span>}
          </div>
        </article>

        <div class="project-pair">
          <article class="project-card project-fjd">
            <div class="project-preview fjd-preview">
              <div class="fjd-top"><span>FJD / WORKSHOP</span><span>SURBITON</span></div>
              <div class="fjd-wheel"><div><i></i><i></i><i></i><i></i><i></i><b>FJD</b></div></div>
              <div class="fjd-copy"><strong>Good care.<br />More miles<span>.</span></strong><small>READY FOR THE ROAD AHEAD&nbsp;&nbsp; ↗</small></div>
            </div>
            <div class="project-info compact">
              <span class="project-number">02</span>
              <div><h3>{projects.fjdAutos.name}</h3><p>A cleaner, friendlier online presence for a trusted family-run garage.</p></div>
              {projects.fjdAutos.url ? <a class="project-link" href={projects.fjdAutos.url} target="_blank" rel="noreferrer">View live site ↗</a> : <span class="project-status">Live site coming soon</span>}
            </div>
          </article>

          <article class="project-card project-nails">
            <div class="project-preview nails-preview">
              <div class="nails-copy"><span>A LITTLE TIME FOR YOU</span><strong>Make room<br />for <em>me-time.</em></strong></div>
              <div class="nails-photo"><img src="/projects/kt-nails/manicure.png" alt="French manicure created for the KT Nails website" loading="lazy" /></div>
              <div class="nails-brand">KT <em>Nails & Spa</em></div>
            </div>
            <div class="project-info compact">
              <span class="project-number">03</span>
              <div><h3>{projects.ktNails.name}</h3><p>A soft, polished salon website built around calm, care and everyday luxury.</p></div>
              {projects.ktNails.url ? <a class="project-link" href={projects.ktNails.url} target="_blank" rel="noreferrer">View live site ↗</a> : <span class="project-status">Live site coming soon</span>}
            </div>
          </article>
        </div>
      </div>
    </section>

    <section class="process shell" aria-labelledby="process-title">
      <div class="process-copy">
        <p class="eyebrow">02 / How I work</p>
        <h2 id="process-title">Clear process.<br />No mystery.</h2>
        <p>Strategy, design and development stay connected from the first conversation to launch.</p>
      </div>
      <ol>
        <li><span>01</span><div><h3>Find the sharpest idea</h3><p>We clarify what makes the business valuable, who needs to care and what the website must achieve.</p></div></li>
        <li><span>02</span><div><h3>Build the visual world</h3><p>Direction, type, colour, imagery and layout come together into a system that feels genuinely yours.</p></div></li>
        <li><span>03</span><div><h3>Refine every detail</h3><p>I develop, test and polish the experience across screens until the whole thing feels effortless.</p></div></li>
      </ol>
    </section>

    <section class="studio-section" id="studio">
      <div class="studio-grid shell">
        <div class="studio-card" aria-hidden="true">
          <span class="studio-card-label">MADHATTER / INDEPENDENT STUDIO</span>
          <div class="hat"><i></i><b></b><span></span></div>
          <strong>Curiosity<br />over convention.</strong>
        </div>
        <div class="studio-copy">
          <p class="eyebrow">03 / The studio</p>
          <h2>Small studio.<br /><em>High standards.</em></h2>
          <p>Madhatter is an independent creative studio helping ambitious businesses look as good as the work they do.</p>
          <p>You work directly with the person designing and building the site. Fewer handovers, clearer decisions and a lot more care in the final result.</p>
          <a class="text-link" href="/enquire/">Let's talk about your project <span>↗</span></a>
        </div>
      </div>
    </section>

    <section class="final-cta shell">
      <div>
        <p class="eyebrow">Have something good in mind?</p>
        <h2>Let's make it<br /><em>look the part.</em></h2>
      </div>
      <a class="cta-orbit" href="/enquire/" aria-label="Start a project">
        <span>START A PROJECT</span><strong>↗</strong>
      </a>
    </section>
  </main>

  <footer class="site-footer shell">
    <div class="footer-brand">
      <a class="brand" href="#top" aria-label="Madhatter Studio, back to top"><span class="brand-word"><span>Mad</span><em>hatter</em></span><span class="brand-tag">Creative studio</span></a>
      <p>Distinctive websites for ambitious businesses.</p>
    </div>
    <div><h3>Start a conversation</h3><a href="/enquire/">Project enquiry ↗</a></div>
    <div><h3>Find me</h3><a href="#">Instagram ↗</a><a href="#">LinkedIn ↗</a></div>
    <small>© 2026 Madhatter Studio</small>
  </footer>

</Layout>

{
  "name": "madhatter-studio",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "lint": "eslint . --max-warnings=0",
    "test": "vitest run",
    "check": "astro check && tsc -p tsconfig.worker.json",
    "validate": "npm run lint && npm run test && npm run check && npm run build",
    "dev:cloudflare": "npm run build && wrangler dev",
    "deploy": "npm run build && wrangler deploy"
  },
  "dependencies": {
    "astro": "7.4.7",
    "mimetext": "^3.0.28"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.5",
    "@cloudflare/workers-types": "^5.20261028.1",
    "@eslint/js": "^10.0.1",
    "eslint": "^10.15.0",
    "eslint-plugin-astro": "^1.7.0",
    "globals": "^17.14.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.73.0",
    "vitest": "^5.1.0",
    "wrangler": "^4.47.0"
  }
}

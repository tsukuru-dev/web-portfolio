{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "madhatter-studio",
  "main": "worker/index.ts",
  "compatibility_date": "2026-11-13",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  "send_email": [{ "name": "ENQUIRY_EMAIL" }]
}
